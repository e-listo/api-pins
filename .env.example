# URL koneksi MariaDB lengkap:
# mysql+pymysql://USER:PASSWORD@HOST/DATABASE
DATABASE_URL=

# Digunakan Flask dan penandatanganan JWT HS256.
# Buat nilai acak yang panjang dan unik untuk setiap environment.
SECRET_KEY=

# API key yang dikirim PIJAR ke endpoint eksternal PINS.
PIJAR_API_KEY=

# Endpoint eksternal PIJAR yang dipanggil oleh PINS.
PIJAR_API_URL=https://api.pjujogja.id/api/v1/eksternal

# API key yang dikirim PINS saat memanggil PIJAR.
PINS_TO_PIJAR_KEY=
